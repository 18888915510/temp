 }
 
-module.exports = { FILE, lastModel, lastEntry, rememberModel, chooseLaunchModel, recheckLaunchChoice };
+// 自动会话的模型替代（2026-11-12 用户报：助理问答点了「确认切换并继续」还是不断弹框）：
+// 自动会话按「账号即模型」不改号的默认模型，而助理每问开一个新会话，新会话又按原模型起、又停下来问。
+// 用户在确认框里把原模型换成新模型后，按号记下「原模型 → 新模型」；之后这个号的自动会话要用原模型时直接用新模型。
+// 只写 Hub 数据目录，不碰 CodeAgent 的 settings.json。新模型已不在权威清单里时不用（回到正常确认）。
+// 文件：codeagent-model-replacements.json：{ "<号 id 或 personal>": { "<原模型小写>": { from, to, at } } }。
+const REPLACEMENTS_FILE = 'codeagent-model-replacements.json';
+
+function readReplacements(dataDir) {
+  try {
+    const data = JSON.parse(fs.readFileSync(path.join(dataDir, REPLACEMENTS_FILE), 'utf8'));
+    return data && typeof data === 'object' && !Array.isArray(data) ? data : {};
+  } catch { return {}; }
+}
+
+function rememberReplacement(dataDir, account, from, to, now = Date.now()) {
+  if (!dataDir || !from || !to || eq(from, to)) return false;
+  const all = readReplacements(dataDir);
+  const key = String(account || 'personal');
+  const rows = all[key] && typeof all[key] === 'object' && !Array.isArray(all[key]) ? all[key] : {};
+  rows[String(from).toLowerCase()] = { from: String(from), to: String(to), at: new Date(now).toISOString() };
+  // 新模型自己若也被记成过「要换掉」，那条作废：用户刚明确选了它。
+  delete rows[String(to).toLowerCase()];
+  all[key] = rows;
+  const file = path.join(dataDir, REPLACEMENTS_FILE), tmp = file + '.tmp';
+  fs.mkdirSync(dataDir, { recursive: true });
+  fs.writeFileSync(tmp, JSON.stringify(all, null, 2) + '\n', 'utf8');
+  fs.renameSync(tmp, file);
+  return true;
+}
+
+// 返回该用的替代模型，没有返回 ''。known：{ models, authoritative }；清单权威时替代模型必须在清单里。
+function replacementFor(dataDir, account, model, known = null) {
+  if (!dataDir || !model) return '';
+  const rows = readReplacements(dataDir)[String(account || 'personal')];
+  const row = rows && typeof rows === 'object' ? rows[String(model).toLowerCase()] : null;
+  const to = row && typeof row.to === 'string' ? row.to.trim() : '';
+  if (!to || eq(to, model) || !require('./codeagent-models').isSafeModelId(to)) return '';
+  const list = known && Array.isArray(known.models) ? known.models.filter(Boolean) : [];
+  if (known && known.authoritative && list.length) return list.find(m => eq(m, to)) || '';
+  return to;
+}
+
+module.exports = { FILE, REPLACEMENTS_FILE, lastModel, lastEntry, rememberModel, chooseLaunchModel, recheckLaunchChoice, rememberReplacement, replacementFor };
