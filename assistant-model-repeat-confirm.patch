index d4d2ad7..f3d3b63 100644
--- a/core/codeagent-launch-model.js
+++ b/core/codeagent-launch-model.js
@@ -67,4 +67,46 @@ function recheckLaunchChoice({ dataDir, configDir, accountKey = 'personal', firs
