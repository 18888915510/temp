      "extension_approved": "延期获批（生效）",
      "requirement": "补充要求",
      "question": "提问（本身不改变事项）",
      "ack": "收到/确认，无新信息",
      "delivery": "交付",
      "delivery_by_others": "他人之间的交付（当前用户只是知会）",
      "cancel": "取消（整体或部分）",
      "meeting": "与事项相关的会议安排，不改变截止日期",
      "not_applicable_to_user": "与事项相关，但只针对其他人，不影响当前用户",
      "irrelevant": "无关消息（干扰项）"
    },
    "交付状态取值": ["pending", "delivered", "overdue", "cancelled"],
    "方向取值": {
      "inbound": "谁还要交给我",
      "outbound": "我要交给谁",
      "relay": "中转：先从上游收，再交给下游",
      "cc_only": "仅知会，不进入主列表",
      "self": "我自己要完成（无明确交付对象，如考试、填报系统）"
    },
    "distribution_lists": "邮件组地址及其成员。群发给邮件组时，需要展开成员，逐人跟踪。",
    "补充 type": {
      "nil_delivery": "回复“无/没有”，视为已完成",
      "unconfirmed_info": "未经确认的传闻，不能直接作为要求生效",
      "info_confirmed": "对传闻的确认，此时要求才生效"
    }
  },

